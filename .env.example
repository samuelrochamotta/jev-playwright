# Chave do OpenRouter (obrigatória). Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo de decisão (System One). Só responde pelo endpoint /api/alpha/decisions.
JEV_MODEL=typesafe/jev-1.13

# LLM via chat/completions do OpenRouter: baseline llm-only e fallback estrito de contagem no modo jev.
LLM_MODEL=z-ai/glm-5.3-flash

# Navegador visível (false) ou headless (true)
HEADLESS=true

# Exploração de seções (opcionais)
# MAX_ELEMENTS=160          # elementos interativos enviados ao Jev por página
# ARRIVE_THRESHOLD=0.7      # P(chegou) mínima para considerar a seção encontrada
# MAX_DEPTH=4               # cliques máximos a partir da página inicial
# MAX_PAGES_PER_FIND=14     # páginas avaliadas por seção
# REFINE_MIN_GAIN=0.05      # ganho mínimo em P(exato) para aceitar um clique de refinamento na seção
# REFINE_RETRY_DROP=0.3     # em página externa, queda de P(tema) maior que isso espera e reavalia
# MAX_COUNT_CANDIDATES=80   # candidatos da página-alvo julgados pelo Jev numa pergunta "quantos..."
# COUNT_TEXT_CHARS=8000     # texto da página-alvo enviado ao Jev nas contagens
# COLLAPSE_OPTIONS_OVER=20  # listbox com mais opções que isso vira um candidato só (salvo palavra-chave da pergunta)
# MAX_OPENERS_SHOWN=12      # abridores (dropdown/menu/acordeão) mostrados ao Jev por pergunta "quantos..."
# MAX_OPENERS=4             # abridores efetivamente abertos por pergunta "quantos..." para revelar itens
# MAX_REVEAL_DEPTH=2        # níveis de abertura (menu → submenu) por abridor
# MAX_SUB_OPENERS=2         # sub-abridores abertos dentro de cada abridor
# MAX_SCROLL_ROUNDS=4       # rolagens dentro de uma lista virtualizada para revelar mais itens
# WAIT_LOADING_ROUNDS=4     # esperas extras enquanto o snapshot tem placeholders de carga (Power BI etc.)
# LLM_EXPLORE_TURNS=25      # turnos do LLM por seção no modo llm-only

# Navegação nova (best-first é o padrão; dfs mantém o baseline)
# SEARCH_STRATEGY=best-first
# CANDIDATE_LIMIT=24
# FRONTIER_LIMIT=100
# MAX_ACTION_ERRORS=3
# MAX_SOURCES=8
# MAX_DOWNLOAD_BYTES=10000000
# MAX_RECORDS=1000
# RECIPE_DIR=.jev-recipes
# Coleta, receitas e fallback são ativados explicitamente por flags CLI.
